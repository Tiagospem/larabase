{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.larabase.app',
  asar: true,
  asarUnpack: [
    'node_modules/@tailwindcss/oxide-darwin-*/**/*',
    'node_modules/lightningcss-darwin-*/**/*',
    'node_modules/bcrypt/**/*',
    'node_modules/cpu-features/**/*',
    'node_modules/**/*.node',
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  productName: 'Larabase',
  compression: 'store',
  directories: {
    output: 'release/${version}',
  },
  files: [
    'dist/**/*',
    'dist-electron/**/*',
    '!**/*.map',
    '!**/node_modules/**/*.{md,markdown,MD,ts,test,tests,spec}',
  ],
  mac: {
    darkModeSupport: true,
    target: [{ target: 'dmg', arch: ['x64', 'arm64'] }],
    x64ArchFiles: '*',
    icon: 'dist/icons/mac/icon.icns',
    hardenedRuntime: false,
    gatekeeperAssess: false,
    notarize: false,
  },
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64', 'ia32'],
      },
    ],
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    installerIcon: 'dist/icons/win/icon.ico',
  },
  linux: {
    target: ['AppImage'],
    icon: 'dist/icons/png/512x512.png',
  },
  publish: {
    provider: 'github',
    owner: 'Tiagospem',
    repo: 'larabase',
    private: false,
  },
}
